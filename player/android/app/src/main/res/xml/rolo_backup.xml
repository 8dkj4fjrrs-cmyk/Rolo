<?xml version="1.0" encoding="utf-8"?>
<!-- What Android's backup keeps of the app (Android 11 and older; newer
     Androids read rolo_data_extraction.xml). Only the saved games: the
     folder "saves" in the app's own folder. The unpacked game beside it is
     left out: it comes with the app again. -->
<full-backup-content>
    <include domain="file" path="saves" />
</full-backup-content>
