diff --git a/3rdparty/CMakeLists.txt b/3rdparty/CMakeLists.txt
index ca947a7..b216d36 100644
--- a/3rdparty/CMakeLists.txt
+++ b/3rdparty/CMakeLists.txt
@@ -70,7 +70,17 @@ set(_1kfetch_manifest "${_AX_ROOT}/manifest.json" CACHE STRING "" FORCE)
 # fetch prebuilts of 1kdist and git sources
 include(${_AX_ROOT}/1k/fetch.cmake)
 
+# Rolo patch: FreeType can be left out (ax_add_3rd(freetype) then does
+# nothing). Something else must then provide FontFreeType's functions
+# (core/2d/FontFreeType.cpp is not built), the core must be built with
+# AX_USE_FREETYPE=0, and AX_WITH_PNG must be off too.
+option(AX_WITH_FREETYPE "Build with FreeType" ON)
+
 function(ax_add_3rd source_dir)
+  if(source_dir STREQUAL "freetype" AND NOT AX_WITH_FREETYPE)
+    return()
+  endif()
+
   set(options EXCLUDE_FROM_ALL NO_LINK)
   set(multiValueArgs TARGETS OPTIONS)
   cmake_parse_arguments(opt "${options}" "" "${multiValueArgs}" ${ARGN})
